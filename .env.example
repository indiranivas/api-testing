# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Port
PORT=8000

# PostgreSQL Database URL
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://username:password@host/database

# Authentication Bearer Token
# Use a strong, unique token for your environment
BEARER_TOKEN=sk-telemetry-master-key-123

# Example for Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@dpg-xxxxx-a.region-postgres.render.com/dbname
